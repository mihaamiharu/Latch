{
  "manifest_version": 3,
  "name": "Latch",
  "version": "0.1.2",
  "minimum_chrome_version": "120",
  "description": "Connect selected existing Work-profile tabs to Playwright CLI from your terminal.",
  "permissions": [
    "tabs",
    "tabGroups",
    "storage",
    "nativeMessaging",
    "alarms"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/latch-16.png",
    "32": "icons/latch-32.png",
    "48": "icons/latch-48.png",
    "128": "icons/latch-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Latch",
    "default_icon": {
      "16": "icons/latch-16.png",
      "32": "icons/latch-32.png"
    }
  },
  "key": ""
}
