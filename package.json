{
  "name": "latch",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "latch": "src/cli.mjs"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:exploration": "LATCH_EXPLORATION=1 node --test test/exploration-browser.test.mjs",
    "test:video-capture": "LATCH_VIDEO_CAPTURE=1 node --test test/video-capture-browser.test.mjs",
    "test:open-tab": "LATCH_OPEN_TAB=1 node --test test/open-tab-browser.test.mjs",
    "test:native-workflow": "LATCH_NATIVE_WORKFLOW=1 node --test test/native-workflow-browser.test.mjs",
    "test:popups": "LATCH_POPUP_WORKFLOW=1 node --test test/popup-workflow.test.mjs",
    "prepare-install": "node src/install.mjs prepare",
    "build": "node src/build.mjs",
    "skills:install": "node src/install-skills.mjs install",
    "skills:status": "node src/install-skills.mjs status",
    "skills:uninstall": "node src/install-skills.mjs uninstall",
    "test:frames-workers": "LATCH_FRAMES_WORKERS=1 node --test test/frame-worker-compat.test.mjs",
    "test:frame-isolation": "LATCH_FRAME_ISOLATION=1 node --test test/frame-worker-isolation.test.mjs",
    "test:files": "LATCH_FILES=1 node --test test/file-transfer-compat.test.mjs",
    "test:file-isolation": "LATCH_FILE_ISOLATION=1 node --test test/file-transfer-isolation.test.mjs",
    "test:evidence": "LATCH_EVIDENCE=1 node --test test/evidence-compat.test.mjs",
    "test:evidence-limits": "LATCH_EVIDENCE_LIMITS=1 node --test test/evidence-limits.test.mjs",
    "test:evidence-isolation": "LATCH_EVIDENCE_ISOLATION=1 node --test test/evidence-isolation.test.mjs",
    "test:evidence-performance": "LATCH_EVIDENCE_PERFORMANCE=1 node --test test/evidence-performance.test.mjs",
    "test:recovery": "LATCH_RECOVERY=1 node --test test/recovery-browser.test.mjs",
    "test:recovery-chaos": "LATCH_RECOVERY_CHAOS=1 node --test test/recovery-chaos.test.mjs",
    "test:release": "node --test test/release.test.mjs test/setup.test.mjs",
    "test:popup-ui": "LATCH_POPUP_UI=1 node --test test/popup-ui.test.mjs",
    "test:installed-kit": "LATCH_INSTALLED_KIT=1 node --test test/installed-kit.test.mjs",
    "test:action-failures": "LATCH_ACTION_FAILURES=1 node --test --test-concurrency=1 test/action-failures-browser.test.mjs",
    "test:identity": "LATCH_IDENTITY=1 node --test test/identity-browser.test.mjs"
  },
  "dependencies": {
    "playwright-core": "1.65.1",
    "ws": "8.22.0"
  }
}
