{
  "name": "@mihaamiharu/latch",
  "version": "1.1.2",
  "description": "Cross-platform Chrome companion extension, native bridge, and flat CLI for AI coding agents",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mihaamiharu/Latch.git"
  },
  "homepage": "https://github.com/mihaamiharu/Latch#readme",
  "bugs": {
    "url": "https://github.com/mihaamiharu/Latch/issues"
  },
  "keywords": [
    "chrome",
    "playwright",
    "ai-agents",
    "browser-automation",
    "claude-code",
    "codex",
    "antigravity"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "bin": {
    "latch": "src/cli.mjs"
  },
  "files": [
    "extension/",
    "src/",
    "!src/build.mjs",
    "skills/latch/",
    "plugins/antigravity/",
    ".claude-plugin/",
    "docs/SUPPORT.md",
    "docs/EXPLORATION-LIBRARY.md",
    "docs/DISTRIBUTION.md",
    "README.md",
    "SETUP.md",
    "PRIVACY.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "test:exploration": "node scripts/test-env.mjs LATCH_EXPLORATION=1 -- --test test/exploration-browser.test.mjs",
    "test:open-tab": "node scripts/test-env.mjs LATCH_OPEN_TAB=1 -- --test test/open-tab-browser.test.mjs",
    "test:native-workflow": "node scripts/test-env.mjs LATCH_NATIVE_WORKFLOW=1 -- --test test/native-workflow-browser.test.mjs",
    "test:popups": "node scripts/test-env.mjs LATCH_POPUP_WORKFLOW=1 -- --test test/popup-workflow.test.mjs",
    "prepare-install": "node src/install.mjs prepare",
    "build": "node src/build.mjs",
    "skills:install": "node src/install-skills.mjs install",
    "skills:status": "node src/install-skills.mjs status",
    "skills:uninstall": "node src/install-skills.mjs uninstall",
    "test:frames-workers": "node scripts/test-env.mjs LATCH_FRAMES_WORKERS=1 -- --test test/frame-worker-compat.test.mjs",
    "test:frame-isolation": "node scripts/test-env.mjs LATCH_FRAME_ISOLATION=1 -- --test test/frame-worker-isolation.test.mjs",
    "test:files": "node scripts/test-env.mjs LATCH_FILES=1 -- --test test/file-transfer-compat.test.mjs",
    "test:file-isolation": "node scripts/test-env.mjs LATCH_FILE_ISOLATION=1 -- --test test/file-transfer-isolation.test.mjs",
    "test:evidence": "node scripts/test-env.mjs LATCH_EVIDENCE=1 -- --test test/evidence-compat.test.mjs",
    "test:evidence-limits": "node scripts/test-env.mjs LATCH_EVIDENCE_LIMITS=1 -- --test test/evidence-limits.test.mjs",
    "test:evidence-isolation": "node scripts/test-env.mjs LATCH_EVIDENCE_ISOLATION=1 -- --test test/evidence-isolation.test.mjs",
    "test:evidence-performance": "node scripts/test-env.mjs LATCH_EVIDENCE_PERFORMANCE=1 -- --test test/evidence-performance.test.mjs",
    "test:release": "node --test test/release.test.mjs test/setup.test.mjs",
    "test:popup-ui": "node scripts/test-env.mjs LATCH_POPUP_UI=1 -- --test test/popup-ui.test.mjs",
    "test:installed-kit": "node scripts/test-env.mjs LATCH_INSTALLED_KIT=1 -- --test test/installed-kit.test.mjs",
    "test:action-failures": "node scripts/test-env.mjs LATCH_ACTION_FAILURES=1 -- --test --test-concurrency=1 test/action-failures-browser.test.mjs",
    "test:identity": "node scripts/test-env.mjs LATCH_IDENTITY=1 -- --test test/identity-browser.test.mjs",
    "test:browser": "node scripts/test-env.mjs LATCH_OPEN_TAB=1 LATCH_ACTION_FAILURES=1 LATCH_POPUP_WORKFLOW=1 LATCH_POPUP_UI=1 LATCH_NATIVE_WORKFLOW=1 LATCH_IDENTITY=1 LATCH_EXPLORATION=1 -- --test --test-concurrency=1 test/open-tab-browser.test.mjs test/action-failures-browser.test.mjs test/popup-workflow.test.mjs test/popup-ui.test.mjs test/native-workflow-browser.test.mjs test/identity-browser.test.mjs test/exploration-browser.test.mjs"
  },
  "dependencies": {
    "playwright-core": "1.65.1",
    "ws": "8.22.0"
  }
}
